# Mercado Pago private access token. Configure this only in the server environment.
MERCADOPAGO_ACCESS_TOKEN=

# Supabase PostgreSQL connection string (use the pooler endpoint for serverless deploys).
DATABASE_URL=

# Supabase Auth: public values may be used in the browser; service role stays server-side.
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL used for the post-payment return flow.
ACADEMY_PUBLIC_URL=https://arkodata.cl
